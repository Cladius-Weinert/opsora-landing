# Opsora Landing — Environment Variables
# Copy to .env.local for local dev. In Vercel, set via `vercel env add` or dashboard.

# Public — exposed to browser (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=https://opsora-gateway.opsora-ai.workers.dev
NEXT_PUBLIC_DASHBOARD_URL=https://opsora-dashboard.vercel.app
NEXT_PUBLIC_DOCS_URL=https://docs.opsora.ai

# Server-only (optional)
# OPSORA_API_KEY=  # if gateway requires auth
# NEXT_PUBLIC_ANALYTICS_ID=

# Vercel auto-injects: VERCEL_URL, VERCEL_REGION (no need to set manually)
